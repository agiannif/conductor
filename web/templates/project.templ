package templates

import (
	"conductor/internal/models"
	"fmt"
)

templ Project(layout LayoutData, project models.Project, tasks []models.Task, users []models.User) {
	@Layout(layout) {
		<div class="p-6">
			<div class="flex items-center justify-between mb-2">
				<div>
					<a href="/" class="text-sm text-gray-500 hover:text-gray-700">← All projects</a>
					<h1 class="text-2xl font-semibold mt-1">{ project.Name }</h1>
					if project.Description != "" {
						<p class="text-sm text-gray-500 mt-1">{ project.Description }</p>
					}
				</div>
				<div class="flex items-center gap-2">
					<button
						hx-get={ fmt.Sprintf("/partials/projects/%d/edit", project.ID) }
						hx-target="#drawer-inner"
						hx-swap="innerHTML"
						@click="drawerOpen = true"
						class="text-sm text-gray-600 border border-gray-300 px-3 py-1.5 rounded hover:bg-gray-50">
						Edit project
					</button>
					<button
						hx-get={ fmt.Sprintf("/partials/tasks/new?project_id=%d", project.ID) }
						hx-target="#drawer-inner"
						hx-swap="innerHTML"
						@click="drawerOpen = true"
						class="bg-teal-700 text-white px-4 py-2 rounded text-sm font-medium hover:bg-teal-800">
						+ Add task
					</button>
				</div>
			</div>
			<!-- Status groups -->
			@statusGroup("To do", models.StatusTodo, tasks)
			@statusGroup("In progress", models.StatusInProgress, tasks)
			@statusGroup("Blocked", models.StatusBlocked, tasks)
			@statusGroup("Done", models.StatusDone, tasks)
		</div>
	}
}

templ statusGroup(label string, status models.Status, tasks []models.Task) {
	<div class="mb-6">
		<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">{ label }</h2>
		<div class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-100">
			for _, t := range tasks {
				if t.Status == status {
					@TaskRow(t)
				}
			}
		</div>
	</div>
}
