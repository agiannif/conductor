package templates

import (
	"conductor/internal/models"
	"fmt"
)

templ Projects(layout LayoutData, projects []models.Project) {
	@Layout(layout) {
		<div class="p-6">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-2xl font-semibold">All projects</h1>
				<button
					hx-get="/partials/projects/new"
					hx-target="#drawer-inner"
					hx-swap="innerHTML"
					@click="drawerOpen = true"
					class="bg-teal-700 text-white px-4 py-2 rounded text-sm font-medium hover:bg-teal-800">
					+ New project
				</button>
			</div>
			if len(projects) == 0 {
				<p class="text-gray-500 text-sm">No projects yet. Create one to get started.</p>
			}
			<div class="space-y-3">
				for _, p := range projects {
					@projectCard(p)
				}
			</div>
		</div>
	}
}

templ projectCard(p models.Project) {
	<div class="bg-white border border-gray-200 rounded-lg" x-data="{ open: false }">
		<button class="w-full flex items-center gap-3 px-4 py-3 text-left" @click="open = !open">
			<svg class="w-4 h-4 text-gray-400 flex-shrink-0 transition-transform duration-150" :class="{ 'rotate-90': open }" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
			</svg>
			<a href={ templ.SafeURL(fmt.Sprintf("/projects/%d", p.ID)) } class="font-medium hover:underline" @click.stop>{ p.Name }</a>
			<span class="ml-auto text-sm text-gray-500">{ fmt.Sprint(p.OpenTasks()) } open · { fmt.Sprint(p.TotalTasks) } total</span>
			<div class="w-24 bg-gray-200 rounded-full h-1.5 ml-3 flex-shrink-0">
				<div class="bg-teal-600 h-1.5 rounded-full" style={ fmt.Sprintf("width:%d%%", p.ProgressPct()) }></div>
			</div>
			<span class="text-sm text-gray-400 w-8 text-right">{ fmt.Sprint(p.ProgressPct()) }%</span>
		</button>
		<div x-show="open" x-cloak>
			<div
				hx-get={ fmt.Sprintf("/partials/tasks?project_id=%d", p.ID) }
				hx-trigger="intersect once"
				class="divide-y divide-gray-100 min-h-[1px]">
			</div>
			<div class="px-4 py-2 border-t border-gray-100 flex items-center gap-4">
				<button
					hx-get={ fmt.Sprintf("/partials/tasks/new?project_id=%d", p.ID) }
					hx-target="#drawer-inner"
					hx-swap="innerHTML"
					@click="drawerOpen = true"
					class="text-sm text-gray-500 hover:text-gray-900">
					+ Add task
				</button>
				<button
					hx-get={ fmt.Sprintf("/partials/projects/%d/edit", p.ID) }
					hx-target="#drawer-inner"
					hx-swap="innerHTML"
					@click="drawerOpen = true"
					class="text-sm text-gray-500 hover:text-gray-900">
					Edit
				</button>
			</div>
		</div>
	</div>
}
