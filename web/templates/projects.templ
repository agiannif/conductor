package templates

import (
	"conductor/internal/models"
	"fmt"
)

templ Projects(layout LayoutData, projects []models.Project, users []models.User, filters models.TaskFilters) {
	@Layout(layout) {
		<div class="pt-5 px-4 sm:pt-8 sm:px-14">
			<div class="flex items-center justify-between mb-5">
				<h1 class="text-[28px] font-normal tracking-[-0.4px] text-primary">All projects</h1>
				<button
					hx-get="/partials/projects/new"
					hx-target="#drawer-inner"
					hx-swap="innerHTML"
					@click="drawerOpen = true"
					class="bg-tertiary text-white px-3 py-[7px] rounded-md text-[13px] font-medium hover:bg-tertiary-hover flex items-center gap-1"
				>
					+ Create project
				</button>
			</div>
			<!-- Toolbar: expand all + filter -->
			<div
				x-data="{ allExpanded: false }"
				class="hidden sm:flex items-center gap-3 mb-4 flex-wrap"
			>
				<button
					@click="allExpanded = !allExpanded; $dispatch('projects-toggle-all', { open: allExpanded })"
					class="text-[13px] text-secondary hover:text-primary"
					x-text="allExpanded ? 'Collapse all' : 'Expand all'"
				>
					Expand all
				</button>
				<span class="text-on-surface-muted text-[13px]">·</span>
				<form method="GET" action="/" class="flex items-center gap-2">
					<select
						name="assignee_id"
						@change="$el.form.submit()"
						class="text-[13px] border border-outline rounded-sm px-2 py-1 bg-surface text-secondary"
					>
						<option value="">All Assignees</option>
						for _, u := range users {
							if filters.AssigneeID == u.ID {
								<option value={ fmt.Sprint(u.ID) } selected>{ u.Username }</option>
							} else {
								<option value={ fmt.Sprint(u.ID) }>{ u.Username }</option>
							}
						}
					</select>
					<select
						name="priority"
						@change="$el.form.submit()"
						class="text-[13px] border border-outline rounded-sm px-2 py-1 bg-surface text-secondary"
					>
						<option value="">All Priorities</option>
						@projectsFilterOption("critical", "Critical", filters.Priority)
						@projectsFilterOption("high", "High", filters.Priority)
						@projectsFilterOption("medium", "Medium", filters.Priority)
						@projectsFilterOption("low", "Low", filters.Priority)
					</select>
					<select
						name="due"
						@change="$el.form.submit()"
						class="text-[13px] border border-outline rounded-sm px-2 py-1 bg-surface text-secondary"
					>
						<option value="">All Due Dates</option>
						@projectsFilterOption("overdue", "Overdue", filters.Due)
						@projectsFilterOption("this_week", "This week", filters.Due)
					</select>
					if filters.AssigneeID != 0 || filters.Priority != "" || filters.Due != "" {
						<a href="/" class="text-[13px] text-secondary hover:text-primary">Clear</a>
					}
				</form>
			</div>
			if len(projects) == 0 {
				<p class="text-secondary text-[13px]">No projects yet.</p>
			}
			<div class="space-y-3">
				for _, p := range projects {
					@projectCard(p, filters)
				}
			</div>
		</div>
	}
}

templ projectCard(p models.Project, filters models.TaskFilters) {
	<div
		class="bg-surface border border-outline rounded"
		x-data="{ open: false }"
		@projects-toggle-all.window="open = $event.detail.open"
	>
		<button
			class="w-full flex items-center gap-3 px-4 py-3 text-left bg-surface-sunken hover:bg-outline-hair rounded-t"
			@click="open = !open"
		>
			<svg
				class="w-4 h-4 text-on-surface-muted flex-shrink-0 transition-transform duration-150"
				:class="{ 'rotate-90': open }"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l7 7-7 7"></path>
			</svg>
			<div class="flex-1 min-w-0 text-left">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/projects/%d", p.ID)) }
					class="text-[15px] font-medium text-primary hover:underline"
					@click.stop
				>
					{ p.Name }
				</a>
				<!-- Mobile stats row below project name -->
				<p class="sm:hidden text-[11px] text-secondary mt-0.5">
					{ fmt.Sprint(p.OpenTasks()) } open · { fmt.Sprint(p.TotalTasks) } total
				</p>
			</div>
			<!-- Desktop stats -->
			<div class="hidden sm:flex items-center gap-3">
				<span class="text-[11px] text-secondary bg-surface-sunken border border-outline-hair rounded-full px-2 leading-5">
					{ fmt.Sprint(p.OpenTasks()) } open
				</span>
				<span class="text-[11px] text-secondary bg-surface-sunken border border-outline-hair rounded-full px-2 leading-5">
					{ fmt.Sprint(p.TotalTasks) } total
				</span>
				<div class="w-20 bg-outline rounded-full h-[3px] flex-shrink-0">
					<div class="bg-tertiary h-[3px] rounded-full" style={ fmt.Sprintf("width:%d%%", p.ProgressPct()) }></div>
				</div>
			</div>
			<!-- Percentage: always visible -->
			<span class="text-[11px] text-secondary tabular-nums w-7 text-right flex-shrink-0">{ fmt.Sprint(p.ProgressPct()) }%</span>
		</button>
		<div x-show="open" x-cloak>
			<div
				hx-get={ fmt.Sprintf("/partials/tasks?project_id=%d%s", p.ID, projectsFiltersQuery(filters)) }
				hx-trigger="intersect once"
				class="divide-y divide-outline-hair border-t border-outline-hair min-h-[1px]"
			></div>
			<div class="px-4 py-2 border-t border-outline-hair flex items-center gap-4">
				<button
					hx-get={ fmt.Sprintf("/partials/tasks/new?project_id=%d", p.ID) }
					hx-target="#drawer-inner"
					hx-swap="innerHTML"
					@click="drawerOpen = true"
					class="text-[13px] font-medium text-tertiary hover:text-tertiary-hover"
				>
					+ Add task
				</button>
				<button
					hx-get={ fmt.Sprintf("/partials/projects/%d/edit", p.ID) }
					hx-target="#drawer-inner"
					hx-swap="innerHTML"
					@click="drawerOpen = true"
					class="text-[13px] font-medium text-tertiary hover:text-tertiary-hover"
				>
					Edit
				</button>
			</div>
		</div>
	</div>
}

templ projectsFilterOption(value, label, current string) {
	if value == current {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

func projectsFiltersQuery(f models.TaskFilters) string {
	s := ""
	if f.AssigneeID != 0 {
		s += fmt.Sprintf("&assignee_id=%d", f.AssigneeID)
	}
	if f.Priority != "" {
		s += "&priority=" + f.Priority
	}
	if f.Due != "" {
		s += "&due=" + f.Due
	}
	return s
}
