package templates

import (
	"conductor/internal/models"
	"fmt"
)

templ TaskRows(tasks []models.Task) {
	for _, t := range tasks {
		@taskRowFull(t)
	}
}

templ TaskRowsWithProject(tasks []models.Task) {
	for _, t := range tasks {
		@taskRowWithProject(t)
	}
}

// TaskRowWithProject is the public alias used by postToggleTask for the All Tasks flat list.
templ TaskRowWithProject(task models.Task) {
	@taskRowWithProject(task)
}

// MyTaskRow is the public alias used by postToggleTask for the My Tasks view.
templ MyTaskRow(task models.Task) {
	@myTaskRow(task)
}

// taskRowFull: no project name — used in single-project view and all-projects expanded cards.
templ taskRowFull(t models.Task) {
	<div
		id={ fmt.Sprintf("task-%d", t.ID) }
		class="flex items-center gap-2 px-4 py-2 cursor-pointer border-b border-outline-hair last:border-0 hover:bg-surface-sunken"
		hx-get={ fmt.Sprintf("/partials/tasks/%d", t.ID) }
		hx-target="#drawer-inner"
		hx-swap="innerHTML"
		hx-trigger="click[!event.target.closest('input')]"
		@click="!$event.target.closest('input') && (drawerOpen = true)"
	>
		<input
			type="checkbox"
			checked?={ t.Status == models.StatusDone }
			hx-post={ fmt.Sprintf("/tasks/%d/toggle", t.ID) }
			hx-target={ fmt.Sprintf("#task-%d", t.ID) }
			hx-swap="outerHTML"
			class="w-4 h-4 rounded-[3px] border-outline accent-tertiary flex-shrink-0"
		/>
		@priorityFlag(t.Priority)
		<span
			class={ "flex-1 text-[13px] min-w-0 truncate",
		              templ.KV("line-through text-on-surface-muted", t.Status == models.StatusDone),
		              templ.KV("text-primary", t.Status != models.StatusDone) }
		>
			{ t.Title }
		</span>
		<div class="flex items-center gap-2 flex-shrink-0">
			if t.Link != "" {
				<svg class="w-3 h-3 text-on-surface-muted flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
					<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
					<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
				</svg>
			}
			@statusPill(t.Status)
			if t.Category != "" {
				<span class="text-[11px] text-secondary bg-surface border border-outline rounded-full px-2 leading-5 whitespace-nowrap flex-shrink-0">{ t.Category }</span>
			}
			<div class="flex-shrink-0 w-[60px]">
				if t.DueDate != nil {
					<span
						class={ "flex items-center gap-1 text-[11px] tabular-nums whitespace-nowrap",
					              templ.KV("text-danger", t.IsOverdue()),
					              templ.KV("text-secondary", !t.IsOverdue()) }
					>
						@iconCalendar()
						{ t.DueDate.Format("Jan 2") }
					</span>
				}
			</div>
			<div class="flex-shrink-0 w-6 h-6">
				if t.AssigneeName != "" {
					<div
						class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-medium"
						style={ fmt.Sprintf("background-color:%s;color:%s", avatarFillByID(t.AssigneeID), avatarTextByID(t.AssigneeID)) }
					>
						{ string([]rune(t.AssigneeName)[:1]) }
					</div>
				}
			</div>
		</div>
	</div>
}

// taskRowWithProject: includes project name — used in the All Tasks flat list where project context is needed.
templ taskRowWithProject(t models.Task) {
	<div
		id={ fmt.Sprintf("task-%d", t.ID) }
		class="flex items-center gap-2 px-4 py-2 cursor-pointer border-b border-outline-hair last:border-0 hover:bg-surface-sunken"
		hx-get={ fmt.Sprintf("/partials/tasks/%d", t.ID) }
		hx-target="#drawer-inner"
		hx-swap="innerHTML"
		hx-trigger="click[!event.target.closest('input')]"
		@click="!$event.target.closest('input') && (drawerOpen = true)"
	>
		<input
			type="checkbox"
			checked?={ t.Status == models.StatusDone }
			hx-post={ fmt.Sprintf("/tasks/%d/toggle?ctx=all_tasks", t.ID) }
			hx-target={ fmt.Sprintf("#task-%d", t.ID) }
			hx-swap="outerHTML"
			class="w-6 h-6 rounded-[3px] border-outline accent-tertiary flex-shrink-0"
		/>
		@priorityFlag(t.Priority)
		<span
			class={ "flex-1 text-[13px] min-w-0 truncate",
		              templ.KV("line-through text-on-surface-muted", t.Status == models.StatusDone),
		              templ.KV("text-primary", t.Status != models.StatusDone) }
		>
			{ t.Title }
		</span>
		<div class="flex items-center gap-2 flex-shrink-0">
			if t.Link != "" {
				<svg class="w-3 h-3 text-on-surface-muted flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
					<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
					<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
				</svg>
			}
			<span class="text-[11px] text-secondary truncate flex-shrink-0 max-w-[100px]">{ t.ProjectName }</span>
			@statusPill(t.Status)
			if t.Category != "" {
				<span class="text-[11px] text-secondary bg-surface border border-outline rounded-full px-2 leading-5 whitespace-nowrap flex-shrink-0">{ t.Category }</span>
			}
			<div class="flex-shrink-0 w-[60px]">
				if t.DueDate != nil {
					<span
						class={ "flex items-center gap-1 text-[11px] tabular-nums whitespace-nowrap",
					              templ.KV("text-danger", t.IsOverdue()),
					              templ.KV("text-secondary", !t.IsOverdue()) }
					>
						@iconCalendar()
						{ t.DueDate.Format("Jan 2") }
					</span>
				}
			</div>
			<div class="flex-shrink-0 w-6 h-6">
				if t.AssigneeName != "" {
					<div
						class="w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-medium"
						style={ fmt.Sprintf("background-color:%s;color:%s", avatarFillByID(t.AssigneeID), avatarTextByID(t.AssigneeID)) }
					>
						{ string([]rune(t.AssigneeName)[:1]) }
					</div>
				}
			</div>
		</div>
	</div>
}

// myTaskRow: simplified row for My Tasks. Shows project name, status, and due date only.
templ myTaskRow(t models.Task) {
	<div
		id={ fmt.Sprintf("task-%d", t.ID) }
		class="flex items-center gap-2 px-4 py-2 cursor-pointer border-b border-outline-hair last:border-0 hover:bg-surface-sunken"
		hx-get={ fmt.Sprintf("/partials/tasks/%d", t.ID) }
		hx-target="#drawer-inner"
		hx-swap="innerHTML"
		hx-trigger="click[!event.target.closest('input')]"
		@click="!$event.target.closest('input') && (drawerOpen = true)"
	>
		<input
			type="checkbox"
			checked?={ t.Status == models.StatusDone }
			hx-post={ fmt.Sprintf("/tasks/%d/toggle?ctx=my_tasks", t.ID) }
			hx-target={ fmt.Sprintf("#task-%d", t.ID) }
			hx-swap="outerHTML"
			class="w-6 h-6 rounded-[3px] border-outline accent-tertiary flex-shrink-0"
		/>
		@priorityFlag(t.Priority)
		<span
			class={ "flex-1 text-[13px] min-w-0 truncate",
		              templ.KV("line-through text-on-surface-muted", t.Status == models.StatusDone),
		              templ.KV("text-primary", t.Status != models.StatusDone) }
		>
			{ t.Title }
		</span>
		<div class="flex items-center gap-2 flex-shrink-0">
			<span class="text-[11px] text-secondary truncate flex-shrink-0 max-w-[130px]">{ t.ProjectName }</span>
			@statusPill(t.Status)
			<div class="flex-shrink-0 w-[60px]">
				if t.DueDate != nil {
					<span
						class={ "flex items-center gap-1 text-[11px] tabular-nums whitespace-nowrap",
					              templ.KV("text-danger", t.IsOverdue()),
					              templ.KV("text-secondary", !t.IsOverdue()) }
					>
						@iconCalendar()
						{ t.DueDate.Format("Jan 2") }
					</span>
				}
			</div>
		</div>
	</div>
}

templ statusPill(s models.Status) {
	switch s {
		case models.StatusInProgress:
			<span class="text-[11px] text-warning bg-warning-container rounded-full px-2 leading-5 flex-shrink-0 whitespace-nowrap">in progress</span>
		case models.StatusDone:
			<span class="text-[11px] text-success bg-success-container rounded-full px-2 leading-5 flex-shrink-0">done</span>
		case models.StatusBlocked:
			<span class="text-[11px] text-danger bg-[rgba(161,63,63,0.1)] rounded-full px-2 leading-5 flex-shrink-0">blocked</span>
		default:
			<span class="text-[11px] text-secondary bg-surface border border-outline rounded-full px-2 leading-5 flex-shrink-0">todo</span>
	}
}

templ priorityFlag(p models.Priority) {
	switch p {
		case models.PriorityCritical:
			<svg class="w-3 h-3 text-danger flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
				<path d="M4 5v18l8-4 8 4V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2z"></path>
			</svg>
		case models.PriorityHigh:
			<svg class="w-3 h-3 text-warning flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
				<path d="M4 5v18l8-4 8 4V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2z"></path>
			</svg>
		default:
			<span class="w-3 h-3 flex-shrink-0"></span>
	}
}

templ iconCalendar() {
	<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
		<line x1="16" y1="2" x2="16" y2="6"></line>
		<line x1="8" y1="2" x2="8" y2="6"></line>
		<line x1="3" y1="10" x2="21" y2="10"></line>
	</svg>
}

func avatarFillByID(id *int64) string {
	if id == nil {
		return "oklch(0.78 0.055 14)"
	}
	return avatarFill(*id)
}

func avatarTextByID(id *int64) string {
	if id == nil {
		return "oklch(0.28 0.04 14)"
	}
	return avatarText(*id)
}
