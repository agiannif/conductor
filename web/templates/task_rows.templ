package templates

import (
	"conductor/internal/models"
	"fmt"
)

// TaskRows renders a list of task rows for the HTMX partial endpoint (getTaskRows).
templ TaskRows(tasks []models.Task) {
	for _, t := range tasks {
		<div id={ fmt.Sprintf("task-%d", t.ID) }
			class="flex items-center gap-3 px-4 py-2 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-0"
			hx-get={ fmt.Sprintf("/partials/tasks/%d", t.ID) }
			hx-target="#drawer-inner"
			hx-swap="innerHTML"
			hx-trigger="click[!event.target.closest('input')]"
			@click="drawerOpen = true">
			<input type="checkbox"
				checked?={ t.Status == models.StatusDone }
				hx-post={ fmt.Sprintf("/tasks/%d/toggle", t.ID) }
				hx-target={ fmt.Sprintf("#task-%d", t.ID) }
				hx-swap="outerHTML"
				class="rounded border-gray-300"/>
			<span class={ "flex-1 text-sm", templ.KV("line-through text-gray-400", t.Status == models.StatusDone) }>{ t.Title }</span>
			<span class="text-xs text-gray-400">{ t.ProjectName }</span>
			<span class="text-xs text-gray-500 px-1.5 py-0.5 rounded bg-gray-100">{ string(t.Status) }</span>
			<span class="text-xs text-gray-500">{ string(t.Priority) }</span>
			if t.AssigneeName != "" {
				<div class="w-6 h-6 rounded-full bg-teal-600 flex items-center justify-center text-white text-xs flex-shrink-0">
					{ string([]rune(t.AssigneeName)[:1]) }
				</div>
			}
			if t.DueDate != nil {
				<span class={ "text-xs", templ.KV("text-red-500", t.IsOverdue()), templ.KV("text-gray-400", !t.IsOverdue()) }>
					{ t.DueDate.Format("Jan 2") }
				</span>
			}
		</div>
	}
}
