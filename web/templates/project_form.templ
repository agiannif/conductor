package templates

import (
	"conductor/internal/models"
	"fmt"
)

type ProjectFormData struct {
	Project *models.Project // nil = create mode, non-nil = edit mode
}

templ ProjectForm(data ProjectFormData) {
	<div class="p-6">
		<h2 class="text-lg font-semibold mb-4">
			if data.Project != nil {
				Edit project
			} else {
				New project
			}
		</h2>
		if data.Project != nil {
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/projects/%d", data.Project.ID)) } class="space-y-4">
				@projectFormFields(data.Project.Name, data.Project.Description)
			</form>
		} else {
			<form method="POST" action="/projects" class="space-y-4">
				@projectFormFields("", "")
			</form>
		}
	</div>
}

templ projectFormFields(name, description string) {
	<div>
		<label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
		<input type="text" id="name" name="name" value={ name } required
			class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"/>
	</div>
	<div>
		<label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
		<textarea id="description" name="description" rows="3"
			class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500">{ description }</textarea>
	</div>
	<div class="flex justify-end gap-2">
		<button type="button" @click="drawerOpen = false"
			class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded hover:bg-gray-50">
			Cancel
		</button>
		<button type="submit"
			class="px-4 py-2 text-sm bg-teal-700 text-white rounded hover:bg-teal-800">
			Save
		</button>
	</div>
}
