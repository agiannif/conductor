package templates

import (
	"conductor/internal/models"
	"fmt"
)

type ProjectFormData struct {
	Project *models.Project
}

templ ProjectForm(data ProjectFormData) {
	<!-- Panel header -->
	<div class="flex items-center justify-between px-5 py-4 border-b border-outline-hair">
		<span class="text-[15px] font-medium text-primary">
			if data.Project != nil {
				Edit project
			} else {
				New project
			}
		</span>
		<button @click="drawerOpen = false" class="p-1 text-secondary hover:text-primary rounded-sm hover:bg-surface-sunken">
			<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>
	<div class="px-5 py-4">
		if data.Project != nil {
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/projects/%d", data.Project.ID)) } class="space-y-4">
				@projectFormFields(data.Project.Name, data.Project.Description, true)
			</form>
		} else {
			<form method="POST" action="/projects" class="space-y-4">
				@projectFormFields("", "", false)
			</form>
		}
	</div>
}

templ ProjectDeleteError(taskCount int) {
	<h2 class="text-[15px] font-medium text-primary mb-2">Cannot delete project</h2>
	<div class="bg-warning-container border border-warning-outline rounded-sm px-3 py-[10px] text-[13px] text-warning mb-6">
		<span class="font-medium">Blocked.</span>
		if taskCount == 1 {
			This project has 1 incomplete task. Complete or reassign it first.
		} else {
			This project has { fmt.Sprint(taskCount) } incomplete tasks. Complete or reassign them first.
		}
	</div>
	<div class="flex justify-end">
		<button
			@click="modalOpen = false"
			class="px-3 py-[7px] text-[13px] text-primary border border-outline rounded-md hover:bg-surface-sunken"
		>
			Got it
		</button>
	</div>
}

templ ProjectDeleteConfirm(project models.Project) {
	<h2 class="text-[15px] font-medium text-primary mb-2">Delete this project?</h2>
	<p class="text-[13px] text-secondary mb-6">
		"{ project.Name }" will be permanently removed. This cannot be undone.
	</p>
	<div class="flex justify-end gap-2">
		<button
			@click="modalOpen = false"
			class="px-3 py-[7px] text-[13px] text-primary border border-outline rounded-md hover:bg-surface-sunken"
		>
			Cancel
		</button>
		<!-- No @click="modalOpen = false" here: on a conflict response the error HTML is swapped
			 into #modal-content and the modal must stay open so the user can read it. -->
		<button
			hx-post={ templ.SafeURL(fmt.Sprintf("/projects/%d/delete", project.ID)) }
			hx-target="#modal-content"
			hx-swap="innerHTML"
			class="px-3 py-[7px] text-[13px] bg-danger text-white rounded-md hover:opacity-90 font-medium"
		>
			Delete project
		</button>
	</div>
}

templ projectFormFields(name, description string, isEdit bool) {
	<div>
		<label for="name" class="block text-[13px] font-medium text-primary mb-1">Name <span class="text-danger">*</span></label>
		<input
			type="text"
			id="name"
			name="name"
			value={ name }
			required
			class="w-full border border-outline rounded-sm px-[10px] py-[7px] text-[13px] text-primary bg-surface focus:outline-none focus:ring-1 focus:ring-tertiary"
		/>
	</div>
	<div>
		<label for="description" class="block text-[13px] font-medium text-primary mb-1">Description <span class="text-on-surface-muted font-normal">(optional)</span></label>
		<textarea
			id="description"
			name="description"
			rows="3"
			class="w-full border border-outline rounded-sm px-[10px] py-[7px] text-[13px] text-primary bg-surface focus:outline-none focus:ring-1 focus:ring-tertiary"
		>{ description }</textarea>
	</div>
	<div class="flex justify-end gap-2 pt-2">
		<button
			type="button"
			@click="drawerOpen = false"
			class="px-3 py-[7px] text-[13px] text-primary border border-outline rounded-md hover:bg-surface-sunken"
		>
			Cancel
		</button>
		<button
			type="submit"
			class="px-3 py-[7px] text-[13px] bg-tertiary text-white rounded-md hover:bg-tertiary-hover font-medium"
		>
			if isEdit {
				Save changes
			} else {
				Create project
			}
		</button>
	</div>
}
