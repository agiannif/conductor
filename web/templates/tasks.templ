package templates

import (
	"conductor/internal/models"
	"fmt"
)

// AllTasks renders the full all-tasks page with filter controls and HTMX task list.
templ AllTasks(layout LayoutData, tasks []models.Task, projects []models.Project, users []models.User, filters models.TaskFilters) {
	@Layout(layout) {
		<div class="p-6">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-2xl font-semibold">All tasks</h1>
				<button
					hx-get="/partials/tasks/new"
					hx-target="#drawer-inner"
					hx-swap="innerHTML"
					@click="drawerOpen = true"
					class="bg-teal-700 text-white px-4 py-2 rounded text-sm font-medium hover:bg-teal-800">
					+ Add task
				</button>
			</div>
			<form
				method="GET"
				action="/tasks"
				hx-get="/partials/tasks"
				hx-target="#task-list"
				hx-swap="innerHTML"
				hx-trigger="change"
				class="flex flex-wrap gap-2 mb-4">
				<!-- Project filter -->
				<select name="project_id" class="text-sm border border-gray-200 rounded px-2 py-1.5 bg-white">
					<option value="">All projects</option>
					for _, p := range projects {
						<option value={ fmt.Sprint(p.ID) } selected?={ filters.ProjectID == p.ID }>{ p.Name }</option>
					}
				</select>
				<!-- Status filter -->
				<select name="status" class="text-sm border border-gray-200 rounded px-2 py-1.5 bg-white">
					<option value="">All statuses</option>
					<option value="todo" selected?={ filters.Status == "todo" }>Todo</option>
					<option value="in progress" selected?={ filters.Status == "in progress" }>In progress</option>
					<option value="blocked" selected?={ filters.Status == "blocked" }>Blocked</option>
					<option value="done" selected?={ filters.Status == "done" }>Done</option>
				</select>
				<!-- Priority filter -->
				<select name="priority" class="text-sm border border-gray-200 rounded px-2 py-1.5 bg-white">
					<option value="">All priorities</option>
					<option value="critical" selected?={ filters.Priority == "critical" }>Critical</option>
					<option value="high" selected?={ filters.Priority == "high" }>High</option>
					<option value="medium" selected?={ filters.Priority == "medium" }>Medium</option>
					<option value="low" selected?={ filters.Priority == "low" }>Low</option>
				</select>
				<!-- Assignee filter -->
				<select name="assignee_id" class="text-sm border border-gray-200 rounded px-2 py-1.5 bg-white">
					<option value="">Anyone</option>
					for _, u := range users {
						<option value={ fmt.Sprint(u.ID) } selected?={ filters.AssigneeID == u.ID }>{ u.Username }</option>
					}
				</select>
				<!-- Due filter -->
				<select name="due" class="text-sm border border-gray-200 rounded px-2 py-1.5 bg-white">
					<option value="">Any due date</option>
					<option value="overdue" selected?={ filters.Due == "overdue" }>Overdue</option>
					<option value="this_week" selected?={ filters.Due == "this_week" }>This week</option>
					<option value="this_month" selected?={ filters.Due == "this_month" }>This month</option>
				</select>
				<button type="submit" class="text-sm border border-gray-200 rounded px-3 py-1.5 bg-white hover:bg-gray-50">Filter</button>
				<a href="/tasks" class="text-sm text-gray-500 hover:text-gray-900 px-2 py-1.5">Clear</a>
			</form>
			<div id="task-list" class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-100">
				if len(tasks) == 0 {
					<p class="text-sm text-gray-500 px-4 py-6">No tasks match your filters.</p>
				} else {
					@TaskRows(tasks)
				}
			</div>
		</div>
	}
}

// MyTasks renders the current-user task page.
templ MyTasks(layout LayoutData, tasks []models.Task) {
	@Layout(layout) {
		<div class="p-6">
			<h1 class="text-2xl font-semibold mb-6">My tasks</h1>
			<div class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-100">
				if len(tasks) == 0 {
					<p class="text-sm text-gray-500 px-4 py-6">You have no tasks.</p>
				} else {
					@TaskRows(tasks)
				}
			</div>
		</div>
	}
}
